# =============================================================================
# FamilyFun — Environment variables template
# =============================================================================
# Copy this file to .env (gitignored since L-07, 04.09.2026) and fill in the values.
# Only VITE_-prefixed variables are exposed to the browser bundle.
#
# Most variables are optional — the app runs with sensible defaults.
# =============================================================================

# --- App ---
# Canonical URL of the site. Used in SEO, Open Graph, Schema.org markup.
VITE_SITE_URL=https://familyfun.pl

# --- Analytics (optional) ---
# Plausible domain for privacy-friendly analytics.
# Leave empty to disable analytics.
VITE_PLAUSIBLE_DOMAIN=

# Google Tag Manager container ID (e.g. GTM-XXXXXX).
# Leave empty to disable.
VITE_GTM_ID=

# --- Backend: Supabase (REQUIRED) ---
# src/integrations/supabase/client.ts reads these three with NO fallback —
# without them the app crashes at startup. Supabase: Settings → API Keys.
# Only the "publishable" key belongs here. NEVER sb_secret_ / service_role.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Legacy name still read by src/config/env.ts (isSupabaseConfigured). Optional.
VITE_SUPABASE_ANON_KEY=

# --- Observability (optional) ---
# Sentry DSN for error tracking.
VITE_SENTRY_DSN=

# --- Feature flag overrides (optional) ---
# Accepted values: "true" / "1" to enable, empty / "false" to disable.
# These override src/lib/featureFlags.ts at runtime — useful for staging.
VITE_ENABLE_ONBOARDING=
